# FireWatch AI - Environment Variables Template
# Copy this file to .env and configure values as needed.
# DO NOT COMMIT YOUR .env FILE OR REAL CREDENTIALS TO GIT.

# Application Environment (development, testing, production)
FIREWATCH_ENV=development

# NASA FIRMS API Map Key (Optional for live API queries)
# Obtain a free key from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

# SQLite Database Path
DATABASE_PATH=firewatch.db

# Notification System Configuration
# Set NOTIFICATION_SIMULATION_MODE=False to enable real live email transmission.
# Default is True for safe evaluation and testing without accidental dispatch.
NOTIFICATION_SIMULATION_MODE=True

# Automated Authority Dispatch & Email Configuration
# Sender Email Address:
SMTP_FROM_EMAIL=mjdp4317@gmail.com
SMTP_USERNAME=mjdp4317@gmail.com

# Nearest Emergency Response / Receiver Email Address:
EMERGENCY_RECEIVER_EMAIL=mjdp8086@gmail.com

# Gmail SMTP Server Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Gmail 16-Character App Password (Required only for live SMTP dispatch)
# Generate from: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification enabled on sender account)
SMTP_PASSWORD=your_16_char_google_app_password_here

# Webhook Configuration (Optional alternative channel)
WEBHOOK_ALERT_URL=https://hooks.example.com/services/alerts
WEBHOOK_SECRET=optional_webhook_signing_secret
