# FireWatch AI - Environment Variables Template
# Copy this file to .env and configure values as needed.
# DO NOT COMMIT YOUR .env FILE OR REAL CREDENTIALS TO GIT.

# Application Environment (development, testing, production)
FIREWATCH_ENV=development

# NASA FIRMS API Map Key (Optional for live download)
# Obtain a free key from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

# SQLite Database Path
DATABASE_PATH=firewatch.db

# Notification System Configuration
# SIMULATION_MODE: Set to True (default) to simulate all notifications without sending real messages.
# Set to False ONLY when authorized and verified.
NOTIFICATION_SIMULATION_MODE=True

# SMTP Email Configuration (Optional - used only if NOTIFICATION_SIMULATION_MODE is False)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.org
SMTP_PASSWORD=example_password_do_not_hardcode
SMTP_FROM_EMAIL=alerts@firewatch.ai

# Webhook Configuration (Optional)
WEBHOOK_ALERT_URL=https://hooks.example.com/services/alerts
WEBHOOK_SECRET=optional_webhook_signing_secret
